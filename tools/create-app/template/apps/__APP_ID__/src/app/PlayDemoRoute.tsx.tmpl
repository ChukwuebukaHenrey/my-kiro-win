// Plays a bundled demo activity at `/play/demo/:id`. The manifest is validated in the browser
// before playback.
import { useMemo, useState, type ReactNode } from 'react';
import { Link, useNavigate, useParams } from 'react-router';
import { validateManifest } from '@dreame/schema';
import { ActivityPlayer, InvalidActivityView } from '@dreame/ui';
import { findDemo, type DemoEntry } from '../demos.ts';
import { appProfile } from '../profile.ts';
import { appViews } from '../views/registry.ts';
import { NotFoundView } from './NotFoundView.tsx';

function newSeed(): number {
  // A one-element array always has index 0.
  return crypto.getRandomValues(new Uint32Array(1))[0] ?? 0;
}

export function PlayDemoRoute(): ReactNode {
  const { id } = useParams();
  const demo = findDemo(id);
  if (demo === undefined) return <NotFoundView />;
  // A new key per demo gives each demo its own validation result, seed and run count.
  return <DemoPlay key={demo.id} demo={demo} />;
}

interface DemoPlayProps {
  readonly demo: DemoEntry;
}

function DemoPlay({ demo }: DemoPlayProps): ReactNode {
  const navigate = useNavigate();
  const result = useMemo(() => validateManifest(demo.json, appProfile), [demo]);
  const [seed, setSeed] = useState(newSeed);
  const [run, setRun] = useState(0);
  const [finished, setFinished] = useState(false);

  if (!result.ok) {
    return (
      <InvalidActivityView
        diagnostics={result.diagnostics}
        actionLabel="Back to home"
        onAction={() => {
          void navigate('/');
        }}
      />
    );
  }

  const playAgain = (): void => {
    setRun((n) => n + 1);
    setSeed(newSeed());
    setFinished(false);
  };

  return (
    <>
      <h1 className="dr-heading">{demo.title}</h1>
      <p>
        <Link to="/">Back to home</Link>
      </p>
      <ActivityPlayer
        key={`${demo.id}#${run}`}
        profile={appProfile}
        manifest={result.manifest}
        seed={seed}
        views={appViews}
        onFinish={() => {
          setFinished(true);
        }}
      />
      {finished ? (
        <button type="button" className="dr-button" onClick={playAgain}>
          Play again
        </button>
      ) : null}
    </>
  );
}
